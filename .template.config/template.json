{
  "$schema": "http://json.schemastore.org/template",
  "author": "Brian Jong",
  "classifications": ["Web", "WebAPI", "Vertical Slice"],
  "identity": "DotnetVsa.Template",
  "name": "Dotnet VSA Template",
  "shortName": "vsa-api",
  "sourceName": "BackendTemplate",
  "preferNameDirectory": true,
  "defaultName": "MyApp",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "docs/**",
            "**/.vs/**",
            "**/bin/**",
            "**/obj/**",
            "**/.git/**"
          ]
        }
      ]
    }
  ],
  "postActions": []
}
